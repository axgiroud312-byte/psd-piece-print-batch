{
  "manifestVersion": 5,
  "id": "com.axgiroud.psd-piece-print-batch",
  "name": "裁片印花批量套图",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0",
    "data": {
      "apiVersion": 2
    }
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "piecePrintPanel",
      "minimumSize": {
        "width": 320,
        "height": 480
      },
      "maximumSize": {
        "width": 1200,
        "height": 1600
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 440,
        "height": 760
      },
      "label": {
        "default": "裁片批量套图"
      }
    }
  ]
}
